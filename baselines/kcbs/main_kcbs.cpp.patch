+// the simulator's goal test: centre within goal_radius of the goal position and, for a
+// robot with a speed state, |v| below stop_speed. Heading is not part of the goal.
+class PositionGoal : public ob::GoalRegion
+{
+public:
+    PositionGoal(const ob::SpaceInformationPtr &si, std::shared_ptr<Robot> robot,
+                 double gx, double gy, double radius, double stop_speed)
+      : ob::GoalRegion(si), robot_(robot), gx_(gx), gy_(gy), stop_speed_(stop_speed)
+    {
+        setThreshold(radius);
+    }
+    double distanceGoal(const ob::State *st) const override
+    {
+        const auto p = robot_->getTransform(st, 0).translation();
+        double d = std::hypot(p(0) - gx_, p(1) - gy_);
+        std::vector<double> reals;
+        si_->getStateSpace()->copyToReals(reals, st);
+        // Outside the radius when too fast, so isSatisfied (distance <= threshold) is the env's test.
+        if (reals.size() > 3 && std::fabs(reals[3]) >= stop_speed_)
+            d = std::max(d, threshold_ + std::fabs(reals[3]) - stop_speed_ + 1e-3);
+        return d;
+    }
+private:
+    std::shared_ptr<Robot> robot_;
+    double gx_, gy_, stop_speed_;
 };
 
